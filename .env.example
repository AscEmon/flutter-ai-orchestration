# Copy to .env and fill from the team vault. NEVER commit .env or paste real values into an AI chat.
# After every change: sh .claude/scripts/setup_secrets.sh && dart run build_runner build --delete-conflicting-outputs

# --- App config (read in Dart via envied → Env.*) ---
API_BASE_URL=[PLACEHOLDER]

# --- Android signing (setup_secrets.sh → android/key.properties + android/app/release.jks) ---
RELEASE_JKS_BASE64=[PLACEHOLDER_BASE64_OF_JKS]
KEYSTORE_PASSWORD=[PLACEHOLDER]
KEY_ALIAS=[PLACEHOLDER]
KEY_PASSWORD=[PLACEHOLDER]

# --- Firebase (setup_secrets.sh → google-services.json / GoogleService-Info.plist) ---
GOOGLE_SERVICES_JSON_BASE64=[PLACEHOLDER_BASE64]
GOOGLE_SERVICE_INFO_BASE64=[PLACEHOLDER_BASE64]

# --- iOS (setup_secrets.sh → ios/Flutter/Secret.xcconfig) ---
GOOGLE_MAPS_API_KEY=[PLACEHOLDER]
