{
  "permissions": {
    "allow": [
      "Bash(ssl_cli help:*)",
      "Bash(ssl_cli create:*)",
      "Bash(ssl_cli module:*)",
      "Bash(ssl_cli generate:*)",
      "Bash(ssl_cli build:*)",
      "Bash(autosafe:*)",
      "Bash(flutter --version)",
      "Bash(flutter create:*)",
      "Bash(flutter pub:*)",
      "Bash(dart pub:*)",
      "Bash(dart run build_runner:*)",
      "Bash(sh .claude/scripts/setup_secrets.sh)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter devices)",
      "Bash(bash .claude/scripts/launch_for_testing.sh:*)",
      "Bash(bash .claude/hooks/check_rules.sh)",
      "Bash(bash .claude/hooks/pre_commit.sh)",
      "Bash(dart analyze:*)",
      "Bash(bash .claude/hooks/stop_gate.sh --manual)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__flutter-skill__connect_app",
      "mcp__flutter-skill__screenshot",
      "mcp__flutter-skill__get_current_route",
      "mcp__flutter-skill__get_widget_tree",
      "mcp__flutter-skill__get_errors",
      "mcp__flutter-skill__inspect",
      "mcp__flutter-skill__tap",
      "mcp__flutter-skill__find_by_type",
      "mcp__flutter-skill__swipe",
      "mcp__flutter-skill__get_text_content",
      "mcp__flutter-skill__get_logs"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./android/key.properties)",
      "Read(./android/local.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/env.g.dart)",
      "Read(./**/Secret.xcconfig)",
      "Read(./**/google-services.json)",
      "Read(./**/GoogleService-Info.plist)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre_bash_git_guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre_edit_guard.sh"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log_subagent.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post_write.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop_gate.sh",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/on_stop.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log_subagent.sh --stop"
          }
        ]
      }
    ]
  }
}
